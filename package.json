{
  "name": "qgames-frontend-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "prettier": "@qgames/config/prettier",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:styles --continue",
    "format": "prettier --write .",
    "api:fetch": "pnpm --filter @qgames/api api:fetch",
    "api:generate": "pnpm --filter @qgames/api api:generate",
    "test:e2e": "pnpm --filter @qgames/e2e test"
  },
  "devDependencies": {
    "@qgames/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
