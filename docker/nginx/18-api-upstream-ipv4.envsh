#!/bin/sh
# Entrypoint образа nginx выполняет (source) этот файл до 20-envsubst-on-templates.sh
# и получает API_UPSTREAM_IPV4 для web.conf.template.
#
# Зачем: host.docker.internal с host-gateway резолвится и в IPv4, и в IPv6, а nginx добавляет в upstream
# все адреса. Подключение по IPv6 из контейнера падает (Network unreachable) — 502 и временная
# пометка upstream недоступным. Поэтому берётся только IPv4-адрес; upstream из одного сервера
# nginx никогда не помечает недоступным (max_fails/fail_timeout для него не действуют).

api_host="${API_UPSTREAM%:*}"
api_port="${API_UPSTREAM##*:}"
if [ -z "$api_host" ] || [ "$api_host" = "$API_UPSTREAM" ]; then
    echo "18-api-upstream-ipv4.envsh: API_UPSTREAM должен быть вида <хост>:<порт>, получено: '$API_UPSTREAM'" >&2
    exit 1
fi
api_ipv4="$(getent ahostsv4 "$api_host" | awk 'NR == 1 { print $1 }')"
if [ -z "$api_ipv4" ]; then
    echo "18-api-upstream-ipv4.envsh: не удалось получить IPv4-адрес бэкенда '$api_host'" >&2
    exit 1
fi
export API_UPSTREAM_IPV4="$api_ipv4:$api_port"
echo "18-api-upstream-ipv4.envsh: upstream бэкенда — $API_UPSTREAM_IPV4 ($API_UPSTREAM)"
