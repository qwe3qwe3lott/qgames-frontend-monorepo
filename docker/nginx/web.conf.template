# nginx образа web: статика portal и admin + reverse proxy API на бэкенд (same-origin, CLAUDE.md §5).
# Шаблон: при старте контейнера entrypoint образа nginx подставляет переменные окружения
# (envsubst заменяет только заданные переменные, поэтому $uri, $host и т.п. остаются переменными nginx)
# и кладёт результат в /etc/nginx/conf.d/web.conf. Значения по умолчанию — ENV в docker/app.Dockerfile:
#   HTTPS_LISTEN / HTTP_LISTEN             — порты в контейнере (8443 / 8080; снаружи — 443 / 80);
#   PORTAL_SERVER_NAME / ADMIN_SERVER_NAME — имена хостов (обязательны: оба сайта на одном порту различаются по имени;
#     локально — <LOCAL_DOMAIN> и admin.<LOCAL_DOMAIN>, в проде — qgames.duckdns.org и admin.qgames.duckdns.org);
#   API_UPSTREAM                           — бэкенд (локально host.docker.internal:8080, в проде app:8080);
#   API_UPSTREAM_RESOLVE                   — true в проде: имя бэкенда перерезолвится через DNS Docker; иначе
#     в upstream попадает только IPv4-адрес (API_UPSTREAM_SERVER, см. 18-api-upstream.envsh);
#   HSTS                                   — значение Strict-Transport-Security (в проде); пусто — заголовка нет.
# Сертификат на оба имени — /etc/nginx/certs/cert.pem и key.pem (том; локально — mkcert из docker/certs/,
# в проде — Let's Encrypt, его HTTP-01 проверка отдаётся из /var/www/acme).

# Заголовки ответа: add_header в location дополняет заголовки server, а не отменяет их (nginx >= 1.29.3).
add_header_inherit merge;
server_tokens off;
# Относительный Location в редиректах nginx: снаружи порт может быть другим.
absolute_redirect off;

# DNS Docker для server ... resolve (прод): адрес app перечитывается раз в 10 с, только IPv4.
resolver 127.0.0.11 valid=10s ipv4=on;

# Keep-alive до бэкенда: соединения переиспользуются. Один сервер: nginx не помечает его
# недоступным после ошибок, max_fails/fail_timeout для единственного сервера не действуют.
# zone нужна для resolve.
upstream qgames_api {
    zone qgames_api 64k;
    server ${API_UPSTREAM_SERVER};
    keepalive 16;
}

# TLS: один сертификат на оба имени. HTTP/2 к браузеру: потоки SSE комнаты и партии не упираются
# в лимит 6 соединений HTTP/1.1 на хост. До бэкенда — HTTP/1.1 (api-proxy.conf).
ssl_certificate /etc/nginx/certs/cert.pem;
ssl_certificate_key /etc/nginx/certs/key.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:1m;
http2 on;

# HTTP: только редирект на HTTPS, проверка живости для healthcheck compose и HTTP-01 проверка Let's Encrypt
# (certbot на хосте пишет токены в webroot, смонтированный в /var/www/acme; локально каталога нет — 404).
server {
    listen ${HTTP_LISTEN} default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        return 200;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Чужое имя хоста (или обращение по IP) по HTTPS — обрыв TLS-рукопожатия, а не сайт с чужим сертификатом.
server {
    listen ${HTTPS_LISTEN} ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen ${HTTPS_LISTEN} ssl;
    server_name ${PORTAL_SERVER_NAME};
    root /usr/share/nginx/html/portal;

    # Заголовки безопасности на всех ответах (always — и на 4xx/5xx, и на ответах бэкенда).
    # HSTS только в проде и без includeSubDomains: local.qgames.duckdns.org — поддомен прода.
    add_header Strict-Transport-Security "${HSTS}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # Google Identity Services (кнопка входа): скрипт, стили, iframe и запросы — только с accounts.google.com/gsi.
    # style-src 'unsafe-inline': GIS ставит inline-стили, react-remove-scroll (Radix Dialog/Select) — <style>.
    # script-src строгий.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # API админки — только на её хосте.
    location /api/admin/ {
        return 404;
    }

    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
    }

    include /etc/nginx/snippets/spa.conf;
}

server {
    listen ${HTTPS_LISTEN} ssl;
    server_name ${ADMIN_SERVER_NAME};
    root /usr/share/nginx/html/admin;

    add_header Strict-Transport-Security "${HSTS}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Админка ходит только в группу API admin (CLAUDE.md §1): прочие /api/ на её хосте — 404.
    location /api/admin/ {
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location /api/ {
        return 404;
    }

    include /etc/nginx/snippets/spa.conf;
}
